    "lyrics": [
      {
        "t": 9,
        "text": "Good morning, friend! Let's get dressed today,"
      },
      {
        "t": 13.8,
        "text": "Put on our clothes and go out to play!"
      },
      {
        "t": 18.6,
        "text": "Put on your T-shirt, Shirt, and Pants,"
      },
      {
        "t": 21.2,
        "text": "Dress, Skirt, or Shorts for a happy dance!"
      },
      {
        "t": 23.6,
        "text": "Two warm Socks and two fast Shoes,"
      },
      {
        "t": 26,
        "text": "Which bright color will you choose?"
      },
      {
        "t": 28.6,
        "text": "Zip your Jacket, wear your Hat,"
      },
      {
        "t": 30.8,
        "text": "We are ready just like that!"
      }
    ]
  },
