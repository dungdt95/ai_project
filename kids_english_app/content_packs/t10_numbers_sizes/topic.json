    "lyrics": [
      {
        "t": 1,
        "text": "Eleven, twelve, and fifteen stars,"
      },
      {
        "t": 3.5,
        "text": "Count to twenty, near and far!"
      },
      {
        "t": 5.9,
        "text": "Some are big and some are small,"
      },
      {
        "t": 8.3,
        "text": "Some are short and some are tall!"
      },
      {
        "t": 10.8,
        "text": "Elephant is big and heavy too,"
      },
      {
        "t": 13.2,
        "text": "Little mouse is small and new!"
      },
      {
        "t": 15.4,
        "text": "Long choo-choo train rolls down the track,"
      },
      {
        "t": 18,
        "text": "Count to twenty forward and back!"
      }
    ]
  },
