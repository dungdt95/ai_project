        "t": 5,
        "text": "Dinner is ready for you and me!"
      },
      {
        "t": 7.3,
        "text": "Put down the Plate and the little Bowl,"
      },
      {
        "t": 9.6,
        "text": "Spoon and Fork on the table roll!"
      },
      {
        "t": 11.9,
        "text": "Chopsticks ready, Napkin neat,"
      },
      {
        "t": 14.4,
        "text": "Yummy soup in the Pot so sweet!"
      },
      {
        "t": 16.7,
        "text": "Water in the Bottle, Glass, and Cup,"
      },
      {
        "t": 19,
        "text": "Sit down nicely and eat it up!"
      }
    ]
