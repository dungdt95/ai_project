        "text": "Run and jump, one, two, three!"
      },
      {
        "t": 5.2,
        "text": "Dance to the music, sing out loud,"
      },
      {
        "t": 7.4,
        "text": "Laugh together, happy and proud!"
      },
      {
        "t": 9.6,
        "text": "Swim like a fish in the water blue,"
      },
      {
        "t": 13.9,
        "text": "Fly like a bird and climb up too!"
      },
      {
        "t": 18.3,
        "text": "Give a warm hug, then sit right down,"
      },
