  "sentences": [
    {
      "id": "p_how_do_you_feel",
      "text": "How do you feel today? I'm happy!",
      "audio": "audio/sentences/p_how_do_you_feel.mp3",
      "vi": "Hôm nay con thấy thế nào? Con rất vui!",
      "pron_vi": "Hao đu diu phiu tu-đây? Ai-mơ hép-pi!"
    },
    {
      "id": "p_dont_be_scared",
      "text": "Don't be scared! Mommy is here!",
      "audio": "audio/sentences/p_dont_be_scared.mp3",
      "vi": "Đừng sợ nhé! Có mẹ ở đây rồi!",
      "pron_vi": "Đôn-tờ bi xờ-ke-đờ! Măm-mi i-zơ hia!"
    }
  ],
