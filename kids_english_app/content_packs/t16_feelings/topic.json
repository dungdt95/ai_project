  "song": {
    "id": "s16_feelings_song",
    "title": "Happy Faces, Many Feelings",
    "audio": "audio/songs/s16_feelings_song.mp3",
    "cover": "images/songs/cover_s16_feelings.png",
    "lyrics": [
      {
        "t": 10.1,
        "text": "How do you feel inside today?"
      },
      {
        "t": 15.5,
        "text": "Every feeling is okay!"
      },
      {
        "t": 20.5,
        "text": "When I am Happy, I smile wide,"
      },
      {
        "t": 25.4,
        "text": "When I am Sad, Mom's by my side!"
      },
      {
        "t": 29.3,
        "text": "Angry or Scared, take a breath so deep,"
      },
      {
        "t": 34.8,
        "text": "Tired and Sleepy, ready to sleep!"
      },
      {
        "t": 39.8,
        "text": "Hungry or Thirsty, Surprised, Excited too,"
      },
      {
        "t": 44.3,
        "text": "Momo is always here with you!"
      }
    ]
  },
