    "lyrics": [
      {
        "t": 1.9,
        "text": "Circle, Square, and Triangle too,"
      },
      {
        "t": 6.6,
        "text": "Shapes are waiting here for you!"
      },
      {
        "t": 11.2,
        "text": "Round like a ball is a Circle bright,"
      },
      {
        "t": 15.9,
        "text": "Four even sides make a Square just right!"
      },
      {
        "t": 20.6,
        "text": "Star in the sky and a pink Heart sweet,"
      },
      {
        "t": 25.2,
        "text": "Rectangle, Oval, and Diamond meet!"
      },
      {
        "t": 30,
        "text": "Draw a straight Line and a Rainbow high,"
      },
      {
        "t": 34.8,
        "text": "Shapes all around under the sky!"
      }
    ]
  },
