        "text": "Who is swimming next to me?"
      },
      {
        "t": 11.2,
        "text": "Dolphin jumps and blue Whale sings,"
      },
      {
        "t": 13.6,
        "text": "Shark and Turtle flap their fins!"
      },
      {
        "t": 16,
        "text": "Octopus waves eight arms high,"
      },
      {
        "t": 18.4,
        "text": "Crab and Starfish say hi-hi!"
      },
      {
        "t": 20.8,
        "text": "Up above, the Bee goes buzz,"
      },
      {
        "t": 23.1,
        "text": "Butterfly and Ladybug dance with us!"
      }
    ]
