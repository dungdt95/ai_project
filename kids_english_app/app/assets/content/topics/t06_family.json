    "lyrics": [
      {
        "t": 5.2,
        "text": "Welcome to my happy home,"
      },
      {
        "t": 7.6,
        "text": "Full of love wherever we roam!"
      },
      {
        "t": 10,
        "text": "Grandma, Grandpa smile so bright,"
      },
      {
        "t": 12.4,
        "text": "Mommy, Daddy hold me tight!"
      },
      {
        "t": 14.8,
        "text": "Brother, Sister, play with me,"
      },
      {
        "t": 17.2,
        "text": "Uncle, Aunt, and Cousin, see!"
      },
      {
        "t": 19.6,
        "text": "One big family under the sun,"
      },
      {
        "t": 23.4,
        "text": "I love you all, everyone!"
      }
    ]
  },
