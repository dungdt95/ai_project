    "lyrics": [
      {
        "t": 0.4,
        "text": "Pack your school Bag, ready, set, go,"
      },
      {
        "t": 2.9,
        "text": "Off to our happy School we go!"
      },
      {
        "t": 5.1,
        "text": "Kind sweet Teacher smiles at the door,"
      },
      {
        "t": 7.3,
        "text": "Friends in the Classroom on the floor!"
      },
      {
        "t": 9.7,
        "text": "Open a Book and read a rhyme,"
      },
      {
        "t": 12.1,
        "text": "Pencil, Crayon, and Paper time!"
      },
      {
        "t": 14.5,
        "text": "Safe little Scissors, cut with care,"
      },
      {
        "t": 16.8,
        "text": "Out to the Playground in the fresh air!"
      }
    ]
  },
